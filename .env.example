# ============================================================
# Kallpa — configuración de IA recomendada
# Cadena: Claude Haiku 5.5 (principal) → Gemini (respaldo gratis) → modelo local
# Si solo pones una de las dos claves, también funciona.
# ============================================================
AI_PROVIDER=auto

# --- Principal: Claude (Anthropic) · https://console.anthropic.com ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Respaldo: Gemini (Google AI Studio, capa gratuita) · https://aistudio.google.com/apikey ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.1-flash-lite
OPENAI_REASONING_EFFORT=low

# (Alternativa) OpenAI oficial:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_REASONING_EFFORT=

AI_TIMEOUT_S=20
REVIEW_THRESHOLD=0.55

# Precio manual (USD por 1M de tokens) si el proveedor cambia tarifas; vacío = tabla interna
# AI_PRICE_IN=
# AI_PRICE_OUT=

# Seguridad (CAMBIAR en producción)
PANEL_TOKEN=demo-abancay
RATE_LIMIT_PER_HOUR=60
# Códigos familiares o tokens equivocados por IP y hora antes de bloquear (anti-enumeración)
FAILED_LOOKUPS_PER_HOUR=20
# Nº de proxies inversos delante de la app (Render/Nginx = 1). 0 = sin proxy: se ignora X-Forwarded-For
TRUSTED_PROXIES=0

# Persistencia
# PostgreSQL (producción, p. ej. Neon). Si está vacío se usa SQLite (archivo local).
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_PATH=instance/kallpa.db
# UPLOAD_DIR=uploads
# DEMO_CODE=K-DEMO1
